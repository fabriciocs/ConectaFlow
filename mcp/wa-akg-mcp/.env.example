# Optional HTTP MCP endpoint mounted in the WA-AKG custom HTTP server (disabled by default).
WA_AKG_MCP_ENABLED=false
WA_AKG_MCP_HTTP_PATH=/mcp

# Local WA-AKG API endpoint used by generated tools. Set to the actual local API base URL.
WA_AKG_API_BASE_URL=http://127.0.0.1:3030/api

# API key for standalone stdio mode only. Generate it once in Dashboard -> OAuth Access -> Local MCP setup.
# Each user/process must use that user's own key. The key is revealed only at first setup.
WA_AKG_API_KEY=

# Override the OpenAPI spec path only if this repository moves.
# WA_AKG_OPENAPI_PATH=C:\\repos\\WA-AKG\\swagger.json

# Writes are disabled by default. Add exact METHOD /path entries to enable individual operations.
# Example only: POST /messages/{sessionId}/{jid}/send
# Optional JSON policy for local writes: scopes, sessionCapabilities and exact operationAllowlist.
# When empty, the generated per-user key has read-only MCP access by default.
WA_AKG_MCP_CREDENTIAL_CAPABILITIES=

# Remote API targets are blocked by default.
WA_AKG_MCP_ALLOW_REMOTE_API=false

WA_AKG_TIMEOUT_MS=15000
WA_AKG_MEDIA_TIMEOUT_MS=120000
WA_AKG_MAX_RESPONSE_BYTES=1000000
