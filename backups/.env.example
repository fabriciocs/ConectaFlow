# Never commit the real .env file.
GITHUB_OWNER=your-github-user-or-org
GITHUB_REPO=system-backups
GITHUB_TOKEN=github_pat_with_repo_permission

# Preferred: age recipient generated with: age-keygen
ENCRYPTION_METHOD=age
AGE_RECIPIENT=age1...
# GPG alternative:
# ENCRYPTION_METHOD=gpg
# GPG_RECIPIENT=backup@example.com

BACKUP_ROOT=/home/evomenu/backups
BACKUP_STAGING_DIR=/tmp/system-backup-staging
GITHUB_BRANCH=main
GITHUB_VISIBILITY=private
DRY_RUN=0
