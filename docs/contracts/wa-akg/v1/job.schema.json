{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/wa-akg/job/v1.json",
  "title": "WA-AKG processing job v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "jobId",
    "correlationId",
    "modality",
    "status",
    "attempts",
    "idempotencyKey",
    "inputReferences"
  ],
  "properties": {
    "contractVersion": { "const": "wa-akg.job.v1" },
    "jobId": { "type": "string", "minLength": 1 },
    "correlationId": { "type": "string", "minLength": 1 },
    "modality": { "type": "string", "enum": ["audio", "image", "document", "web", "video", "text"] },
    "status": {
      "type": "string",
      "enum": ["received", "queued", "processing", "completed", "partial", "failed", "blocked", "cancelled"]
    },
    "attempts": { "type": "integer", "minimum": 0 },
    "idempotencyKey": { "type": "string", "minLength": 1 },
    "inputReferences": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "dependencyJobIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "failureReason": { "type": ["string", "null"] }
  }
}
