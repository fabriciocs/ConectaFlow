# Git
.git
.gitattributes
.gitignore

# Node and nested add-on installs
node_modules
**/node_modules
npm-debug.log*
.yarn

# Build artifacts
.next
out
.plugin-build
*.zip

# Runtime data, local evidence, agent state and credentials cannot enter the build context
data
.remote-desktop
.codex
.claude
.github
.claude-flow
.swarm
uploads
*.db
*.sqlite
.env.validation
Caddyfile.validation

# Source control / logs
*.log
tmp-*.txt
ts_errors*.log
test-*.ts
test-*.js
fix_test.js
*.patch

# Environment: include only the non-secret template
**/.env*
!.env.example

# Docker
.dockerignore
Dockerfile
docker-compose*.yml

# OS
.DS_Store
Thumbs.db

# IDE
.idea
.vscode
*.swp
*.swo

# Security: never package operational backups, encryption identities or runtime logs
backups
**/.age-backup-key
**/*.agekey
**/*.age-identity
**/*.age-private-key
**/backup-audit.log
**/.backup-control
**/.backup.lock

# Never embed encrypted backup archives in images
**/*.age
